{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "decision": { "type": "string", "enum": ["keep", "drop"] },
          "reason": { "type": "string" },
          "valueSignals": { "type": "array", "items": { "type": "string" } },
          "caveat": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["id", "decision", "reason", "valueSignals", "caveat", "confidence"]
      }
    }
  },
  "required": ["decisions"]
}
