{
  "name": "weread-mp-fetcher",
  "version": "1.1.0",
  "description": "通过微信读书抓取公众号文章目录，并归档为本地 Markdown 与图片",
  "type": "module",
  "bin": { "weread-mp-fetcher": "bin/weread.mjs" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "probe": "node bin/weread.mjs --probe"
  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "keywords": ["wechat", "weixin", "mp", "weread", "微信公众号", "微信读书"],
  "files": ["bin", "lib", "docs", "vendor", "config.example.json", "README.md", "LICENSE"]
}
